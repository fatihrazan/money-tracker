# Copy to .env in the repository root. Never commit .env.
DATABASE_URL=postgresql://money:money_dev_only@localhost:5433/money_tracker
APP_ORIGIN=http://localhost:3000
# HTTP local development only. Use true behind HTTPS in production.
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Jakarta
# Optional, only for integration tests; must be a separate empty test database.
# TEST_DATABASE_URL=postgresql://money:money_dev_only@localhost:5433/money_tracker_test

# Optional: Google login and Gmail imports. Keep secrets in the root .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_KEY=
# dev/start runs the worker automatically when credentials and encryption key exist.
# Set false only if running npm run gmail:worker separately (e.g. production scheduler).
GMAIL_SYNC_ENABLED=true

# Optional: Telegram bot created through @BotFather. Never expose the token in the browser.
TELEGRAM_BOT_TOKEN=
# Without the @ prefix; must match getMe for this token.
TELEGRAM_BOT_USERNAME=
# dev/start starts the bot automatically. Set false when running telegram:worker separately.
TELEGRAM_ENABLED=true
# Local development uses polling. Netlify uses webhook (see .env.production.example).
TELEGRAM_TRANSPORT=polling
TELEGRAM_WEBHOOK_SECRET=
# Netlify schedules Gmail every five minutes instead of running a background process.
GMAIL_SCHEDULE_ENABLED=false
# Optional maximum PostgreSQL connections per running instance.
PG_POOL_MAX=5

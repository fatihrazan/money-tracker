# Private file: copy or generate .env.production; never commit filled values.
# Runtime Neon pooled connection. Preserve channel_binding=require when provided.
DATABASE_URL=postgresql://USER:PASSWORD@EP-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# CLI migrations only. Do not upload this variable to Netlify.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/neondb?sslmode=verify-full
APP_ORIGIN=https://YOUR-SITE.netlify.app
COOKIE_SECURE=true
APP_TIMEZONE=Asia/Jakarta
PG_POOL_MAX=3
TELEGRAM_TRANSPORT=webhook
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
GMAIL_SYNC_ENABLED=false
GMAIL_SCHEDULE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_KEY=
